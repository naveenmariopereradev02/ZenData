{
  "name": "zendata-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ZenData FastAPI Python Backend wrapper scripts",
  "scripts": {
    "dev": "./venv/bin/uvicorn app.main:app --reload --reload-exclude 'app/data/*' --reload-exclude 'data/*' --port 8000",
    "start": "./venv/bin/uvicorn app.main:app --port 8000",
    "test": "./venv/bin/python3 -m unittest discover -s tests",
    "install:python": "./venv/bin/pip install -r requirements.txt"
  }
}

